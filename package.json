{
  "name": "wbm-band-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "HOST=0.0.0.0 nuxt dev",
    "generate:base": "nuxt generate",
    "generate": "npm run generate:base && node scripts/create-nonlocalized-aliases.js && node scripts/generate-sitemap.js && node scripts/generate-bio-links.js",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "compress-images": "node scripts/compress-images.js",
    "generate-blurred": "node scripts/generate-blurred-image.js",
    "extract-colors": "node scripts/extract-cover-colors.js",
    "generate-favicons": "node scripts/generate-favicons.js",
    "analyze": "nuxt build --analyze",
    "lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "build:production": "npm run generate",
    "deploy:production": "npm run build:production && node scripts/deploy-production.js",
    "deploy:github": "DEPLOY_TARGET=github nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:attribution": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/test-source-attribution.ts",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue,json,md}": [
      "prettier --write"
    ],
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^8.5.5",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.2",
    "@primevue/forms": "^4.3.6",
    "@primevue/nuxt-module": "^4.3.6",
    "@primevue/themes": "^4.3.6",
    "basic-ftp": "^6.0.1",
    "nuxt": "^3.14.0",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "swiper": "^12.0.3",
    "unhead": "^1.9.7",
    "vue-i18n": "^9.13.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@vueuse/nuxt": "^13.6.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "imagemin": "^9.0.1",
    "imagemin-avif": "^0.1.6",
    "imagemin-webp": "^8.0.0",
    "lint-staged": "^16.2.7",
    "nuxt-gtag": "^4.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "sharp": "^0.34.3",
    "vite-plugin-imagemin": "^0.6.1",
    "vue-tsc": "^3.0.4"
  }
}
