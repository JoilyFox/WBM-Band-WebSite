{
  "name": "wbm-band-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "HOST=0.0.0.0 nuxt dev",
    "generate:base": "nuxt generate",
    "generate": "npm run generate:base && node scripts/generate-sitemap.js && node scripts/generate-bio-links.js",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "compress-images": "node scripts/compress-images.js",
    "generate-blurred": "node scripts/generate-blurred-image.js",
    "extract-colors": "node scripts/extract-cover-colors.js",
    "generate-favicons": "node scripts/generate-favicons.js",
    "campaigns": "node scripts/campaigns.mjs",
    "campaigns:export": "node scripts/campaigns.mjs export",
    "analyze": "nuxt build --analyze",
    "lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "test:perf": "node scripts/perf/lighthouse-check.mjs",
    "build:production": "npm run generate",
    "deploy:production": "npm run build:production && node scripts/deploy-production.js",
    "deploy:github": "DEPLOY_TARGET=github npm run generate:base",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run generate && npm run test:e2e:run",
    "test:e2e:run": "vitest run --config vitest.e2e.config.ts",
    "format": "prettier --write .",
    "prepare": "husky",
    "screenshots": "node scripts/screenshot-devices.mjs"
  },
  "lint-staged": {
    "*.{js,ts,vue,json,md}": [
      "prettier --write"
    ],
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@nuxtjs/i18n": "^8.5.5",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.2",
    "@primevue/forms": "^4.3.6",
    "@primevue/nuxt-module": "^4.3.6",
    "@primevue/themes": "^4.3.6",
    "basic-ftp": "^6.0.1",
    "nuxt": "^3.14.0",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "swiper": "^12.0.3",
    "unhead": "^1.9.7",
    "vue-i18n": "^9.13.1"
  },
  "devDependencies": {
    "@google-analytics/admin": "^9.1.0",
    "@google-analytics/data": "^6.1.0",
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/test-utils": "^4.0.3",
    "@pinia/testing": "^1.0.3",
    "@testing-library/vue": "^8.1.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.10",
    "@vueuse/nuxt": "^13.6.0",
    "autoprefixer": "^10.4.21",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lighthouse": "^12.8.2",
    "lint-staged": "^16.2.7",
    "nuxt-gtag": "^4.1.0",
    "playwright-core": "^1.60.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "sharp": "^0.34.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.0.4"
  }
}
