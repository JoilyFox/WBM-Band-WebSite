<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: apex -> www (301).
  #
  # https://wbmband.com/ used to answer 200 and serve the whole site with no
  # redirect, so the same content lived on two hosts. Every page already
  # self-canonicalises to the www host, but a canonical is only a hint — a
  # redirect is the strongest consolidation signal Google accepts, and the
  # Search Console property is scoped to the www host, so anything crawled on
  # the apex was invisible in the reports. See docs/search-console.md.
  RewriteCond %{HTTP_HOST} !^$
  RewriteCond %{HTTP_HOST} !^www\.wbmband\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^ https://www.wbmband.com%{REQUEST_URI} [R=301,L]

  # Canonical trailing slash: /path/ -> /path (301).
  #
  # DirectorySlash is Off and the rules below serve a directory's index.html
  # internally, so BOTH /en and /en/ answered 200 with identical content — every
  # URL on the site existed twice. Every page self-canonicalises to the
  # slash-less form and the sitemap lists that form, but a canonical is only a
  # hint: Google still crawled the English home as two URLs and reported
  # "Duplicate, Google chose different canonical than user" for it. Redirect
  # instead. The root "/" is excluded — `.+` needs a path segment before the
  # slash — and nothing in the app links to the slashed form.
  # See docs/search-console.md.
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Disable automatic directory slash redirect
  DirectorySlash Off

  # Legacy locale prefix: /ua/... -> /... (301).
  #
  # Ukrainian used to be a prefixed locale, so /ua/listen/x and friends were real
  # URLs that the clean URLs were merely file-copies of. Ukrainian is now the
  # UNPREFIXED default locale (nuxt.config i18n `strategy: 'prefix_except_default'`),
  # so /ua/* no longer exists — redirect the old form to the canonical clean one
  # instead of 404ing shared links and anything Google already knows.
  RewriteRule ^ua$ / [R=301,L]
  RewriteRule ^ua/(.*)$ /$1 [R=301,L]

  # Share/attribution URLs: /listen/<slug>, /listen/<source>/<slug> and the
  # /pre-save + /lyrics equivalents are prerendered directories, but Apache only
  # finds their index.html when the request maps to a real path. These serve it
  # internally so the clean URL is preserved (no redirect).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/(listen|pre-save|lyrics)/[^/]+(/[^/]+)?$
  RewriteRule ^(listen|pre-save|lyrics)/(.*)$ /$1/$2/index.html [L]

  # Same for the English variants.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/en/(listen|pre-save|lyrics)/[^/]+(/[^/]+)?$
  RewriteRule ^en/(listen|pre-save|lyrics)/(.*)$ /en/$1/$2/index.html [L]

  # DirectorySlash is Off (above), so a real directory requested WITHOUT a
  # trailing slash (e.g. /en, /privacy-policy) never reaches its DirectoryIndex and Apache
  # returns 403. Serve that directory's index.html internally — no redirect, so
  # the clean URL is preserved (matching how the app links to /en and the
  # unprefixed Ukrainian routes).
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # SPA Fallback - serve the empty SPA shell for unknown routes (only for
  # non-existing files). This is 200.html, NOT index.html: index.html is now a
  # real prerendered document (the Ukrainian home), so falling back to it would
  # flash homepage content before the client router resolves the real page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 200.html [L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
