<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Disable automatic directory slash redirect
  DirectorySlash Off

  # Internal rewrite for /pre-save/<slug> AND /pre-save/<source>/<slug> to index.html.
  # The optional group matches the source-prefix attribution paths (e.g. /pre-save/i/<slug>).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/pre-save/[^/]+(/[^/]+)?$
  RewriteRule ^pre-save/(.*)$ /ua/pre-save/$1/index.html [L]

  # Internal rewrite for /listen/<slug> AND /listen/<source>/<slug> to index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/listen/[^/]+(/[^/]+)?$
  RewriteRule ^listen/(.*)$ /ua/listen/$1/index.html [L]

  # Internal rewrite for /ua/pre-save/<slug> AND /ua/pre-save/<source>/<slug> to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/ua/pre-save/[^/]+(/[^/]+)?$
  RewriteRule ^ua/pre-save/(.*)$ /ua/pre-save/$1/index.html [L]

  # Internal rewrite for /ua/listen/<slug> AND /ua/listen/<source>/<slug> to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/ua/listen/[^/]+(/[^/]+)?$
  RewriteRule ^ua/listen/(.*)$ /ua/listen/$1/index.html [L]

  # Internal rewrite for /en/pre-save/<slug> AND /en/pre-save/<source>/<slug> to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/en/pre-save/[^/]+(/[^/]+)?$
  RewriteRule ^en/pre-save/(.*)$ /en/pre-save/$1/index.html [L]

  # Internal rewrite for /en/listen/<slug> AND /en/listen/<source>/<slug> to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/en/listen/[^/]+(/[^/]+)?$
  RewriteRule ^en/listen/(.*)$ /en/listen/$1/index.html [L]

  # Internal rewrite (not redirect) for /pre-save/* to serve /ua/pre-save/* content
  # This keeps the URL the same but serves the localized content
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/pre-save/
  RewriteRule ^pre-save/(.*)$ /ua/pre-save/$1 [L]
  
  # Internal rewrite (not redirect) for /listen/* to serve /ua/listen/* content
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/listen/
  RewriteRule ^listen/(.*)$ /ua/listen/$1 [L]

  # DirectorySlash is Off (above), so a real directory requested WITHOUT a
  # trailing slash (e.g. /ua, /en) never reaches its DirectoryIndex and Apache
  # returns 403. Serve that directory's index.html internally — no redirect, so
  # the clean URL is preserved (matching how the app links to /ua and /en).
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # SPA Fallback - serve index.html for all routes (only for non-existing files)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
