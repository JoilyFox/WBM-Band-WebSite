# Netlify/Vercel redirects file (unused by the current Apache/FTP + GitHub Pages
# deploys — kept so a move to such a host preserves the routing contract).
#
# Ukrainian is the UNPREFIXED default locale, so /listen/* and /lyrics/* ARE the
# canonical Ukrainian URLs — they must not be redirected anywhere. Only the
# retired /ua prefix redirects, to the clean form.
/ua/*  /:splat  301

# SPA fallback for client-side routing (the empty shell, not the home page).
/*  /200.html  200
